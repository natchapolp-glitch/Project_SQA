worktrees/

# Tool/editor files
.idea/
.vscode/
*.iml
*.log
!results/**/*.log


# Generated language artifacts
__pycache__/
*.py[cod]
*.class
# OS files
.DS_Store
Thumbs.db
tmp/
.chart-data-*/

# Private browser proof can show unrelated chat history. Keep in local evidence ZIP.
**/provider-screen.png
**/provider-screen.jpg
**/account-screen.jpg
**/ai-evaluator.lock
**/*provider-screen*.png
ai-tests/**/*.png
results/**/*.png
output/*.zip
output/**/*.zip
!ai-tests/provider-captures/**/*.log

# API854 credentials and single-host runtime state (never package or publish).
.local/
.superpowers/
*.sqlite
*.sqlite-*
.env
.env.*
!.env.example

# Worker credentials outside the default runtime must stay private.
*.private.json

